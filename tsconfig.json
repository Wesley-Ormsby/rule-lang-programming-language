{
  "compilerOptions": {
    "outDir": "dist",
    "target": "ES2020",
    "module": "nodenext",
    "declaration": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strictNullChecks": true
  },
  "include": ["src"],
  "exclude": ["/node_modules"],
}
