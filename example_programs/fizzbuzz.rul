begin >> 1

num as x 
    if x > 100         !> empty() # Stop the loop at 100 iterations
    elif mod(x 15) = 0 >> [ add(x 1) !print("FizzBuzz")]
    elif mod(x 3) = 0  >> [ add(x 1) !print("Fizz")] 
    elif mod(x 5) = 0  >> [ add(x 1) !print("Buzz")] 
    else               >> [ add(x 1) !print(x)] 