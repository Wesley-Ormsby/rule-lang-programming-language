import string

begin 
    >> [ CheckPalidrome input("Enter a word: ") ]
CheckPalidrome str as word
    !> str_split(str_lowercase(word) "")
    !> reverse()
    => [
        str str as (part1 part2) -> join(part1 part2)
    ]
    >> word
str str as (reversed word) if reversed = str_lowercase(word) !> printf("% is a palindrome!" word)
str str as (reversed word) !> printf("% is not a palindrome!" word)