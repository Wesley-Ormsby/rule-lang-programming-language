import string

begin 
    >> [ CheckPalidrome input("Enter a word: ") ]
CheckPalidrome str as word
    !> str_split(str_lowercase(word) "")
    !> reverse()
    => [
        str str as (part1 part2) -> join(part1 part2)
    ]
    >> word
str str as (reversed word) if reversed = str_lowercase(word) !> print(join(word " is a palindrome!"))
str str as (reversed word) !> print(join(word " is not a palindrome!"))