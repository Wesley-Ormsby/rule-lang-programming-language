import string

def word := input("Enter a word: ")

begin 
    !> str_split(str_lowercase(word) "")
    !> reverse()
    => [
        str str as (part1 part2) -> join(part1 part2)
    ]
    
str as reversed 
    if reversed = str_lowercase(word) 
        !> printf("% is a palindrome!" word)
    else 
        !> printf("% is not a palindrome!" word)